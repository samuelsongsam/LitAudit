# LitAudit 环境变量。复制为 .env 后按需填写。
# 默认在线检索。演示金标快照或无网络时设为 1。

LITAUDIT_OFFLINE=0
LITAUDIT_DATA_DIR=data
LITAUDIT_FIXTURES_DIR=data/fixtures
LITAUDIT_RUNS_DIR=runs
LITAUDIT_LOG_LEVEL=INFO
LITAUDIT_LIVE_LIMIT=12

# OpenAlex 礼貌池（可选，建议填真实邮箱）
# OPENALEX_MAILTO=you@example.com

# Semantic Scholar 无密钥时容易 HTTP 429，有密钥可降低限流
# SEMANTIC_SCHOLAR_API_KEY=

# 对话总论的 OpenAI 兼容接口（未配置时使用可核验模板降级）
# LITAUDIT_LLM_API_KEY=
# LITAUDIT_LLM_BASE_URL=https://api.openai.com/v1
# LITAUDIT_LLM_MODEL=gpt-4o-mini
