# LitAudit 环境变量。复制为 .env 后按需填写。
# 默认在线检索。演示金标快照或无网络时设为 1。

LITAUDIT_OFFLINE=0
LITAUDIT_DATA_DIR=data
LITAUDIT_FIXTURES_DIR=data/fixtures
LITAUDIT_RUNS_DIR=runs
LITAUDIT_LOG_LEVEL=INFO
LITAUDIT_LIVE_LIMIT=12

# OpenAlex 免费 API Key。匿名查询额度较低，申请地址 https://openalex.org/settings/api
# OPENALEX_API_KEY=
# 可选联系邮箱
# OPENALEX_MAILTO=you@example.com

# 对话的 OpenAI 兼容接口；未配置时可回放记录、搜索已有全文和人工整理方法。
# LITAUDIT_LLM_API_KEY=
# LITAUDIT_LLM_BASE_URL=https://api.openai.com/v1
# LITAUDIT_LLM_MODEL=gpt-4o-mini

# 仅供确定性回归或无模型演示；正式语义检索请下载模型并保留默认配置。
# LITAUDIT_MAP_EMBEDDER=hash
# LITAUDIT_RERANK_EMBEDDER=hash

# 独立数据工作区：应在启动进程前设置，源码运行默认使用项目目录。
# PowerShell示例：$env:LITAUDIT_HOME='C:/research/LitAudit-workspace'
# 此项请设置为进程环境变量，不能仅在本文件中取消注释。

# 可选 OCR：安装系统 Tesseract，或为 PyMuPDF 指定本地语言数据目录。
# LITAUDIT_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=models/tessdata
# LITAUDIT_OCR_LANG=eng
