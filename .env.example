# LitAudit 环境变量。复制为 .env 后按需填写。
# 第一轮离线 pipeline 不需要任何 API 密钥。

LITAUDIT_OFFLINE=1
LITAUDIT_DATA_DIR=data
LITAUDIT_FIXTURES_DIR=data/fixtures
LITAUDIT_RUNS_DIR=runs
LITAUDIT_LOG_LEVEL=INFO

# 后续真实检索再用，当前 pipeline 不会读取这些值去访问网络。
# ARXIV_BASE_URL=https://export.arxiv.org/api/query
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_MAILTO=
